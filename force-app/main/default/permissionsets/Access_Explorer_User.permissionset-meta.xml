<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <applicationVisibilities>
        <application>Access_Explorer</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>AccessExplorerEntityController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AccessExplorerUserController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Access_Explorer_User</name>
    </customPermissions>
    <description
  >Grants access to the Access Explorer app, which shows administrators which users can access objects, fields, permissions and setup entities, and why.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Access Explorer User</label>
    <tabSettings>
        <tab>Access_Explorer</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewRoles</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewSetup</name>
    </userPermissions>
</PermissionSet>
